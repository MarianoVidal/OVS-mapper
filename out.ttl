core:BuildingComponent a owl:Class ;
    rdfs:label "Building component"@en ;
    rdfs:comment "A part that constitutes a piece of a building's structural makeup. E.g., Facade, Wall, Slab, RoofInner, etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Building ;
            owl:onProperty core:componentOfBuilding ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:BuildingComponent ;
            owl:onProperty core:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Collection ;
            owl:onProperty core:includedIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:BuildingComponent ;
            owl:onProperty core:isPartOf ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass core:BuildingComponent ;
            owl:onProperty core:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Document ;
            owl:onProperty core:hasDocument ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass core:Building ;
            owl:onProperty core:componentOfBuilding ] ;
    o2o:endpoint "buildingcomponent" ;
    o2o:included true .

