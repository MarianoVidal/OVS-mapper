foaf:Document a owl:Class .

foaf:OnlineAccount a owl:Class ;
    rdfs:label "OnlineAccount"@en .

foaf:account a owl:ObjectProperty ;
    rdfs:label "account"@en .

foaf:maker a owl:ObjectProperty ;
    rdfs:label "maker"@en ;
    rdfs:comment "An agent that made this thing."@en ;
    rdfs:range foaf:Agent .

<https://w3id.org/rec/building/PersonalHygiene> a owl:Class ;
    rdfs:subClassOf core:Room .

core:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "The human, group, or machine that consumes or acts upon an object or data. This higher-level grouping allows properties that are shared among its subclasses (Person, Organization, Company, Department...) to be anchored in one joint place, on the Agent class."@en ;
    o2o:endpoint "agent" ;
    o2o:included true .

core:SpaceCollection a owl:Class ;
    rdfs:label "Space collection"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Space ;
            owl:onProperty core:includes ],
        [ a owl:Restriction ;
            owl:onProperty core:includes ;
            owl:someValuesFrom core:Space ],
        core:Collection .

core:componentOf a owl:ObjectProperty ;
    rdfs:label "component of"@en ;
    rdfs:comment "Links a Building Component to a Space, that the Building Component is either contained in, adjacent to or intersecting with."@en ;
    rdfs:domain core:BuildingComponent ;
    rdfs:range core:Space ;
    owl:inverseOf core:hasBuildingComponent .

core:hasBuildingComponent a owl:ObjectProperty ;
    rdfs:label "has building component"@en ;
    rdfs:comment "Links a Space to a BuildingComponent that is either contained in, adjacent to or intersecting with the Space."@en ;
    rdfs:domain core:Space ;
    rdfs:range core:BuildingComponent .

core:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:range core:Space .

core:type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:range xsd:string .

v1:QuantitativeValue a owl:Class ;
    rdfs:label "Quantitative value"@en ;
    rdfs:comment """A quantitative value is a numerical interval that represents the range of a certain gr:quantitativeProductOrServiceProperty in terms of the lower and upper bounds for a particular gr:ProductOrService. It is to be interpreted in combination with the respective unit of measurement. Most quantitative values are intervals even if they are in practice often treated as a single point value.

Example: a weight between 10 and 25 kilogramms, a length between 10 and 15 milimeters.

Compatibility with schema.org: This class is equivalent to http://schema.org/Quantity."""@en .

ns2:Space a owl:Class ;
    rdfs:label "Space"@en ;
    rdfs:comment "A Space is a place where data resides, e.g. on a website, desktop, fileshare, etc."@en ;
    rdfs:isDefinedBy ns2: ;
    owl:disjointWith ns2:UserAccount .

geo:hasSerialization a owl:DatatypeProperty ;
    rdfs:label "has serialization"@en ;
    rdfs:comment """Connects a geometry object with its text-based serialization.

GeoSPARQL is Copyright (c) 2012 Open Geospatial Consortium, Inc. All Rights Reserved. http://www.opengeospatial.org/ogc/document."""@en ;
    rdfs:isDefinedBy geo: ;
    rdfs:range rdfs:Literal .

