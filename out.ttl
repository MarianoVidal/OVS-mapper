    rdfs:label "Document"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Collection ;
            owl:onProperty core:includedIn ] ;
    o2o:endpoint "document" ;
    o2o:included true .

core:Room a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:comment "Base class for all more specific room types."@en ;
    rdfs:subClassOf core:BuildingComponent,
        core:Space ;
    o2o:endpoint "room" ;
    o2o:included true .

core:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    rdfs:comment "Member entities of a collection; e.g., a Campus includes some Space, an Apartment includes some Room, etc."@en ;
    rdfs:domain core:Collection .

