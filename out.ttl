core:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "An administrative grouping of entities that are adressed and treated as a unit for some purpose. These entities may have some spatial arrangement (e.g., an apartment is typically contiguous) but that is not a requirement (see, e.g., a distributed campus consisting of spatially disjoint plots or buildings)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Document ;
            owl:onProperty core:hasDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Collection ;
            owl:onProperty core:includedIn ] ;
    o2o:endpoint "collection" ;
    o2o:included true .

core:hasLocationAttribute a owl:DatatypeProperty ;
    rdfs:label "has location attribute"@en ;
    rdfs:comment "This property is a cognitive clustering for human consumption, grouping sub-properties that assign labels (e.g., place names, addresses, etc.) to Geometry entities. This branch of the property hierarchy may need some further development and cleaning up in future versions."@en ;
    rdfs:subPropertyOf geo:hasSerialization .

