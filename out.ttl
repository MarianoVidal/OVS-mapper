@prefix : <https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix core: <https://w3id.org/rec/core/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ns: <http://creativecommons.org/ns#> .
@prefix ns1: <http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#> .
@prefix ns2: <http://rdfs.org/sioc/ns#> .
@prefix ns3: <https://w3id.org/rec#> .
@prefix o2o: <https://karlhammar.com/owl2oas/o2o.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix v1: <http://purl.org/goodrelations/v1#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns:license a owl:AnnotationProperty .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:range xsd:dateTime .

dc:description a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:DatatypeProperty ;
    rdfs:label "title"@en .

v1:Business rdfs:label "Business (business entity type)"@en ;
    rdfs:comment "The gr:BusinessEntityType representing such agents that are themselves offering commercial services or products on the market. Usually, businesses are characterized by the fact that they are officially registered with the public administration and strive for profits by their activities."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

v1:Enduser rdfs:label "Enduser (business entity type)"@en ;
    rdfs:comment "The gr:BusinessEntityType representing such agents that are purchasing the good or service for private consumption, in particular not for resale or for usage within an industrial enterprise. By default, a Business Entity is an Enduser."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

v1:LeaseOut a v1:BusinessFunction,
        owl:NamedIndividual ;
    rdfs:label "Lease Out (business function)"@en ;
    rdfs:comment "This gr:BusinessFunction indicates that the gr:BusinessEntity offers (or seeks) the temporary right to use the specified gr:ProductOrService."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

v1:PublicInstitution rdfs:label "Public institution (business entity type)"@en ;
    rdfs:comment "The gr:BusinessEntityType representing such agents that are part of the adminstration or owned by the public."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

v1:Reseller rdfs:label "Reseller (business entity type)"@en ;
    rdfs:comment "The gr:BusinessEntityType representing such agents that are purchasing the scope of products included in the gr:Offering for resale on the market. Resellers are also businesses, i.e., they are officially registered with the public administration and strive for profits by their activities."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

v1:condition a owl:DatatypeProperty ;
    rdfs:label "condition (0..1)"@en ;
    rdfs:comment "A textual description of the condition of the product or service, or the products or services included in the offer (when attached to a gr:Offering)"@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range rdfs:Literal .

v1:description a owl:DatatypeProperty ;
    rdfs:label "description (0..1)"@en ;
    rdfs:comment """A short textual description of the resource. 

This property is semantically equivalent to rdfs:comment and just meant as a handy shortcut for marking up data."""@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range rdfs:Literal .

v1:hasBusinessFunction a owl:ObjectProperty ;
    rdfs:label "has business function (1..*)"@en ;
    rdfs:comment """This specifies the business function of the gr:Offering, i.e. whether the gr:BusinessEntity is offering to sell, to lease, or to repair the particular type of product. In the case of bundles, it is also possible to attach individual business functions to each gr:TypeAndQuantityNode. The business function of the main gr:Offering determines the business function for all included objects or services, unless a business function attached to a gr:TypeAndQuantityNode overrides it.
	
Note: While it is possible that an entity is offering multiple types of business functions for the same set of objects (e.g. rental and sales), this should usually not be stated by attaching multiple business functions to the same gr:Offering, since the gr:UnitPriceSpecification for the varying business functions will typically be very different."""@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range v1:BusinessFunction .

v1:hasCurrency a owl:DatatypeProperty ;
    rdfs:label "has currency (1..1)"@en ;
    rdfs:comment "The currency for all prices in the gr:PriceSpecification given using the ISO 4217 standard (3 characters)."@en ;
    rdfs:domain v1:PriceSpecification ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:string .

v1:hasPriceSpecification a owl:ObjectProperty ;
    rdfs:label "has price specification (0..*)"@en ;
    rdfs:comment """This links a gr:Offering to a gr:PriceSpecification or specifications. There can be unit price specifications, payment charge specifications, and delivery charge specifications. For each type, multiple specifications for the same gr:Offering are possible, e.g. for different quantity ranges or for different currencies, or for different combinations of gr:DeliveryMethod and target destinations.

Recommended retail prices etc. can be marked by the gr:priceType property of the gr:UnitPriceSpecification."""@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range v1:PriceSpecification .

v1:hasUnitOfMeasurement a owl:DatatypeProperty ;
    rdfs:label "has unit of measurement (1..1)"@en ;
    rdfs:comment "The unit of measurement for a gr:QuantitativeValue, a gr:UnitPriceSpecification, or a gr:TypeAndQuantityNode given using the UN/CEFACT Common Code (3 characters)."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:string .

v1:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value (0..1)"@en ;
    rdfs:comment "This subproperty specifies that the upper and lower limit of the given gr:QuantitativeValue are identical and have the respective value. It is a shortcut for such cases where a quantitative property is (at least practically) a single point value and not an interval."@en ;
    rdfs:domain v1:QuantitativeValue ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

v1:priceType a owl:DatatypeProperty ;
    rdfs:label "price type (0..1)"@en ;
    rdfs:comment """This attribute can be used to distinguish multiple different price specifications for the same gr:Offering. It supersedes the former gr:isListPrice property. The following values are recommended:

The absence of this property marks the actual sales price.

SRP: "suggested retail price" - applicable for all sorts of a non-binding retail price recommendations, e.g. such published by the manufacturer or the distributor. This value replaces the former gr:isListPrice property.

INVOICE: The invoice price, mostly used in the car industry - this is the price a dealer pays to the manufacturer, excluding rebates and charges."""@en ;
    rdfs:domain v1:UnitPriceSpecification ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:string .

<http://purl.org/rss/1.0/modules/content/encoded> a owl:DatatypeProperty ;
    rdfs:label "encoded"@en ;
    rdfs:comment """An element whose contents are the entity-encoded or CDATA-escaped version of the content of the item. Example:

<content:encoded><![CDATA[<p>What a <em>beautiful</em> day!</p>]]></content:encoded>"""@en ;
    rdfs:range xsd:string .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns2:Container a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:comment "An area in which content Items are contained."@en ;
    rdfs:isDefinedBy ns2: ;
    owl:disjointWith ns2:Item,
        ns2:UserAccount .

ns2:about a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    rdfs:comment "Specifies that this Item is about a particular resource, e.g. a Post describing a book, hotel, etc."@en ;
    rdfs:domain ns2:Item ;
    rdfs:isDefinedBy ns2: .

ns2:account_of a owl:ObjectProperty ;
    rdfs:label "account of"@en ;
    rdfs:comment "Refers to the foaf:Agent or foaf:Person who owns this sioc:UserAccount."@en ;
    rdfs:domain ns2:UserAccount ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range foaf:Agent ;
    owl:inverseOf foaf:account .

ns2:content a owl:DatatypeProperty ;
    rdfs:label "content"@en ;
    rdfs:comment "The content of the Item in plain text format."@en ;
    rdfs:domain ns2:Item ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range rdfs:Literal .

ns2:creator_of a owl:ObjectProperty ;
    rdfs:label "creator of"@en ;
    rdfs:comment "A resource that the UserAccount is a creator of."@en ;
    rdfs:domain ns2:UserAccount ;
    rdfs:isDefinedBy ns2: ;
    owl:inverseOf ns2:has_creator .

ns2:embeds_knowledge a owl:ObjectProperty ;
    rdfs:label "embeds knowledge"@en ;
    rdfs:comment "This links Items to embedded statements, facts and structured content."@en ;
    rdfs:domain ns2:Item ;
    rdfs:isDefinedBy ns2: .

ns2:id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:comment "An identifier of a SIOC concept instance. For example, a user ID. Must be unique for instances of each type of SIOC concept within the same site."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range rdfs:Literal .

ns2:link a owl:ObjectProperty ;
    rdfs:label "link"@en ;
    rdfs:comment "A URI of a document which contains this SIOC object."@en ;
    rdfs:isDefinedBy ns2: .

ns2:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "The name of a SIOC concept instance, e.g. a username for a UserAccount, group name for a Usergroup, etc."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range rdfs:Literal .

ns2:read_at a owl:DatatypeProperty ;
    rdfs:label "read at"@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range xsd:dateTime .

ns2:related_to a owl:ObjectProperty ;
    rdfs:label "related to"@en ;
    rdfs:comment "Related resources for this resource, e.g. for Posts, perhaps determined implicitly from topics or references."@en ;
    rdfs:isDefinedBy ns2: .

<http://schema.org/Place> a owl:Class ;
    rdfs:label "Place"@en .

<http://schema.org/seller> a owl:ObjectProperty ;
    rdfs:label "seller"@en ;
    rdfs:comment "An entity which offers (sells / leases / lends / loans) the services / goods. A seller may also be a provider."@en ;
    rdfs:range foaf:Agent .

cpannotationschema:coversRequirements a owl:AnnotationProperty .

owl:deprecated a owl:AnnotationProperty .

foaf:homepage a owl:AnnotationProperty .

foaf:made a owl:ObjectProperty ;
    rdfs:label "made"@en ;
    rdfs:comment "Something that was made by this agent."@en ;
    rdfs:domain foaf:Agent ;
    owl:inverseOf foaf:maker .

o2o:endpoint a owl:AnnotationProperty .

o2o:included a owl:AnnotationProperty .

<https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl> a owl:Ontology ;
    rdfs:label "Property Ontology"@en ;
    ns:license <https://opensource.org/licenses/MIT> ;
    dc:contributor "Diego Torres"^^xsd:string ;
    dc:creator "Felipe Dioguardi"^^xsd:string ;
    dc:description """This ontology covers multiple types of properties and buildings on the real estate market, and real estate listings from different sites that advertise them.

It is mainly based on the RealEstateCore and Semantically-Interlinked Online Communities ontologies."""@en ;
    dc:publisher "LIFIA"@en ;
    vann:preferredNamespacePrefix "pr"@en ;
    rdfs:comment "Pronto is a work-in-progress; requirements are rather unclear as of yet."@en ;
    rdfs:seeAlso <http://rdfs.org/sioc/>,
        <http://rdfs.org/sioc/spec>,
        <http://sioc-project.org>,
        <http://www.heppnetz.de/ontologies/goodrelations/v1>,
        <https://realestatecore.io>,
        <https://w3id.org/rec/>,
        <https://xmlns.com/foaf/spec/> .

:disposition a owl:DatatypeProperty ;
    rdfs:label "disposition"@en ;
    rdfs:comment "Cardinal point in which the property is facing."@en ;
    rdfs:domain core:Space ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:has_feature a owl:ObjectProperty ;
    rdfs:domain core:Space ;
    rdfs:range :Feature .

:has_number_of_rooms a owl:DatatypeProperty ;
    rdfs:label "has number of rooms"@en ;
    rdfs:range xsd:int .

:has_size_specification a owl:ObjectProperty ;
    rdfs:label "has size specification (0..*)"@en ;
    rdfs:comment """This links a rec:Space to a pr:SizeSpecification or specifications. Multiple specifications for the same rec:Space are possible, e.g. for different surfaces measured or for different units.

The specific surface measured can be marked by the gr:sizeType property of the pr:SizeSpecification."""@en ;
    rdfs:domain core:Space ;
    rdfs:range :SizeSpecification .

:has_value a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    rdfs:domain :Feature ;
    rdfs:range rdfs:Literal .

:is_brand_new a owl:DatatypeProperty ;
    rdfs:label "is brand new"@en ;
    rdfs:comment "Whether the Building or Land has been inhabited before."@en ;
    rdfs:domain core:Space ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:is_finished a owl:DatatypeProperty ;
    rdfs:label "is finished"@en ;
    rdfs:comment "Whether the building process has been completed"@en ;
    rdfs:domain core:Space ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:luminosity a owl:DatatypeProperty ;
    rdfs:label "luminosity"@en ;
    rdfs:comment "The brightness or luminosity of the property."@en ;
    rdfs:domain core:Space ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:orientation a owl:DatatypeProperty ;
    rdfs:label "orientation"@en ;
    rdfs:comment "Where the property is facing."@en ;
    rdfs:domain core:Space ;
    rdfs:subPropertyOf owl:topDataProperty .

:property_type a owl:DatatypeProperty ;
    rdfs:label "property type"@en ;
    rdfs:domain core:Space ;
    rdfs:range xsd:string .

:size_type a owl:DatatypeProperty ;
    rdfs:label "size type (0..1)"@en ;
    rdfs:comment "The type of surface measured by a SizeSpecification, e.g. \"Covered\", \"Total\"."@en ;
    rdfs:domain :SizeSpecification ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

schema:address a owl:DatatypeProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "Physical address of the item."@en ;
    rdfs:domain core:Space .

schema:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "The latitude of a location. For example 37.42242 (WGS 84)."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

schema:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "The longitude of a location. For example -122.08585 (WGS 84)."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/rec/building/Bathroom> a owl:Class ;
    rdfs:subClassOf core:Room .

<https://w3id.org/rec/building/Bedroom> a owl:Class ;
    rdfs:subClassOf core:Room .

<https://w3id.org/rec/building/Garage> a owl:Class ;
    rdfs:subClassOf core:Room .

<https://w3id.org/rec/building/Toilet> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/rec/building/PersonalHygiene> .

core:Land a owl:Class ;
    rdfs:label "Land"@en ;
    rdfs:comment "A piece of land upon which one or more buildings may be situated."@en ;
    rdfs:subClassOf core:Space .

core:RealEstate a owl:Class ;
    rdfs:label "Real estate"@en ;
    rdfs:comment "The legal/administrative representation of some lands and/or buildings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:includes ;
            owl:someValuesFrom core:Space ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Space ;
            owl:onProperty core:includes ],
        core:SpaceCollection ;
    o2o:endpoint "realestate" ;
    o2o:included true .

core:Region a owl:Class ;
    rdfs:label "Region"@en ;
    rdfs:comment "An administrative geospatial unit larger than the individual real estate. For instance, \"Lombary\", \"North America\", \"The Back Bay\", \"Elnätsområde Syd\", etc."@en ;
    rdfs:subClassOf core:Space .

core:SubBuilding a owl:Class ;
    rdfs:label "Sub-building"@en ;
    rdfs:comment "A part of a larger building complex, e.g., a wing, a tower, or an interconnected (through walkways or other means) but largely free-standing building."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf [ a rdf:List ;
                            rdf:first "Tower" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Wing" ;
                                    rdf:rest () ] ] ] ;
            owl:onProperty core:type ],
        core:Space .

core:documentTopic a owl:ObjectProperty ;
    rdfs:label "document topic"@en ;
    rdfs:domain core:Document ;
    owl:inverseOf core:hasDocument .

core:hasCity a owl:DatatypeProperty ;
    rdfs:label "has city"@en ;
    rdfs:comment "Indicates a city that a certain Geometry is part of."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasCountry a owl:DatatypeProperty ;
    rdfs:label "has country"@en ;
    rdfs:comment "Indicates a country that a certain Geometry is part of."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasGeonamesId a owl:DatatypeProperty ;
    rdfs:label "has geonames ID"@en ;
    rdfs:comment """Linking to https://www.geonames.org

E.g. for Stockholm (Sweden):
LocationUUID#1 hasGenonames http://www.geonames.org/2673730/stockholm.html"""@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasPostalAddress a owl:DatatypeProperty ;
    rdfs:label "has postal address"@en ;
    rdfs:comment "Address used for postal delivery."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasRegion a owl:DatatypeProperty ;
    rdfs:label "has region"@en ;
    rdfs:comment "Indicates a region that a certain Geometry is part of."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasVistingAddress a owl:DatatypeProperty ;
    rdfs:label "has visting address"@en ;
    rdfs:comment "An address for visiting the Geometry. If a Geometry has multiple visiting addresses, then just add as many hasVistingAddress as needed."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:hasZipCode a owl:DatatypeProperty ;
    rdfs:label "has zip code"@en ;
    rdfs:comment "Indicates a certain Geometry's zip code."@en ;
    rdfs:subPropertyOf core:hasLocationAttribute .

core:isLocatedAtLocalCoordinates a owl:DatatypeProperty ;
    rdfs:label "is located at local coordinates"@en ;
    rdfs:comment "Expressed as a string adhering to the notation \"(x,y,z)\", where x, y, and z ar whole or decimal numbers indicating the position in the local building coordinate system, measured in meters. This relates to the outside world coordinate refence system via the values expressed by GeoReferenceOrigo."@en ;
    rdfs:subPropertyOf geo:hasSerialization .

core:isLocationOf a owl:ObjectProperty ;
    rdfs:label "is location of"@en ;
    rdfs:domain core:Space ;
    owl:inverseOf core:locatedIn .

ns2:Post a owl:Class ;
    rdfs:label "Post"@en ;
    rdfs:comment "An article or message that can be posted to a Forum."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Item,
        foaf:Document .

ns2:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "A Site can be the location of an online community or set of communities, with UserAccounts and Usergroups creating Items in a set of Containers. It can be thought of as a web-accessible data Space."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Space .

ns2:has_creator a owl:ObjectProperty ;
    rdfs:label "has creator"@en ;
    rdfs:comment "A resource that the UserAccount is a creator of."@en ;
    rdfs:isDefinedBy ns2: .

<http://rdfs.org/sioc/spec> rdfs:label "SIOC Core Ontology Specification" .

ns1:Cochera rdfs:subClassOf ns3:RealEstate .

ns1:Edificio rdfs:subClassOf ns3:RealEstate .

ns1:None rdfs:subClassOf ns3:RealEstate .

