core:Space a owl:Class ;
    rdfs:label "Space"@en ;
    rdfs:comment "A contiguous part of the physical world that has a 3D spatial extent and that contains or can contain sub-spaces. E.g., a Region can contain many pieces of Land, which in turn can contain many Buildings."@en ;
    rdfs:seeAlso "https://schema.org/Place"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom core:Document ;
            owl:onProperty core:hasDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Space ;
            owl:onProperty core:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Collection ;
            owl:onProperty core:includedIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:Space ;
            owl:onProperty core:isPartOf ] ;
    o2o:endpoint "space" ;
    o2o:included true .

