core:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document"@en ;
    rdfs:range core:Document .

core:includedIn a owl:ObjectProperty ;
    rdfs:label "included in"@en ;
    rdfs:comment "Indicates that an entity is included in some Collection, e.g., a Building is included in a RealEstate, or a Room is included in an Apartment."@en ;
    rdfs:range core:Collection ;
    owl:inverseOf core:includes .

core:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Indicates a super-entity of the same base type (i.e., Spaces only have Spaces as parents, Organizations only have Organizations, etc)."@en .

v1:PriceSpecification a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:comment "The superclass of all price specifications."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

ns2:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "An Item is something which can be in a Container."@en ;
    rdfs:isDefinedBy ns2: ;
    owl:disjointWith ns2:Space,
        ns2:UserAccount .

